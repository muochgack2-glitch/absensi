              "id": "to",
              "name": "toNumber",
              "value": "={{ $json.userPhone }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "textMsg",
              "value": "❓ Perintah tidak dikenali. Ketik *help*",
              "type": "string"
            },
            {
              "id": "url",
              "name": "urlPath",
              "value": "=https://absensi.smkpgriblora.sch.id/wa-reply?phone={{ $json.userPhone }}&message={{ encodeURIComponent('❓ Perintah tidak dikenali. Ketik *help*') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-unknown",
      "name": "Set Unknown",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [840, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.urlPath }}",
        "options": {}
      },
      "id": "http-wa",
      "name": "Send to WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 300]
    }
  ],
