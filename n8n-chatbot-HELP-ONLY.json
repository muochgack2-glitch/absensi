        "jsCode": "// Extract phone from webhook body\nconst rawPhone = $json.body.from || '';\n\n// Clean phone number\nlet phone = String(rawPhone);\nphone = phone.replace('@s.whatsapp.net', '');\nphone = phone.replace('@lid', '');\nphone = phone.replace('@jid', '');\nphone = phone.replace('@g.us', '');\n\n// Hardcoded help message\nconst helpMsg = '🤖 *MENU CHATBOT WALI KELAS*\\n\\nPerintah:\\n1️⃣ *help* - Menu ini\\n2️⃣ *ringkasan* - Lihat absensi\\n\\n_SMK PGRI Blora_';\n\n// Return in correct format\nreturn [{\n  json: {\n    phone: phone,\n    message: helpMsg\n  }\n}];"
      },
