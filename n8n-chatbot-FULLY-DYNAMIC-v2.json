{
  "name": "WhatsApp Chatbot - Fully Dynamic v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-chatbot-dynamic",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wa-chatbot-dynamic"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.body.from.split('@')[0] }}",
              "type": "string"
            },
            {
              "id": "command",
              "name": "command",
              "value": "={{ $json.body.message.toLowerCase() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "parse",
      "name": "Parse Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "help",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "help"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "ringkasan",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ringkasan"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "switch",
      "name": "Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.phone }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "🤖 *MENU CHATBOT WALI KELAS*\n\nPerintah:\n1️⃣ *ringkasan* - Lihat absensi hari ini\n2️⃣ *help* - Menu ini\n\n---\n_Sistem Absensi SMK PGRI Blora_",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-help",
      "name": "Help Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 200]
    },
    {
      "parameters": {
        "url": "=https://absensi.smkpgriblora.sch.id/api/chatbot/summary/{{ $json.phone }}",
        "options": {}
      },
      "id": "api",
      "name": "Get Summary API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $('Parse Input').item.json.phone }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "=Ringkasan {{ $json.data.kelas_nama }}:\nHadir: {{ $json.data.hadir }}\nAlpha: {{ $json.data.alpha }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-ringkasan",
      "name": "Format Ringkasan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.phone }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "❓ Perintah tidak dikenali. Ketik *help*",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-unknown",
      "name": "Unknown Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://absensi.smkpgriblora.sch.id/wa-reply",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http",
      "name": "Send to WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"phone\": $('Parse Input').item.json.phone } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Parse Input",
