            "index": 0
          }
        ]
      ]
    },
    "Parse Input": {
      "main": [
        [
          {
            "node": "Switch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch": {
      "main": [
        [
          {
            "node": "Help Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get Summary API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Unknown Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Help Message": {
      "main": [
        [
          {
            "node": "Send to WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Summary API": {
      "main": [
        [
          {
            "node": "Format Ringkasan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Ringkasan": {
