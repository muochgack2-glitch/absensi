        "jsCode": "// Get input data safely\nvar inputData = $input.first().json;\nvar body = inputData.body || {};\nvar rawPhone = body.from || '';\n\n// Clean phone number (basic replace)\nvar phone = String(rawPhone);\nif (phone.indexOf('@') > -1) {\n  phone = phone.split('@')[0];\n}\n\n// Simple help message\nvar helpMsg = 'Test pesan dari n8n';\n\n// Create JSON string\nvar payload = {\n  phone: phone,\n  message: helpMsg\n};\n\nvar jsonString = JSON.stringify(payload);\n\n// Return output\nreturn [{\n  json: {\n    phone: phone,\n    message: helpMsg,\n    payload: jsonString\n  }\n}];"
